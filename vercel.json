{
  "version": 2,
  "builds": [
    {
      "src": "BACKEND-NODEJS/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "FRONT-END-VUEJS/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "BACKEND-NODEJS/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "FRONT-END-VUEJS/dist/$1"
    }
  ]
}
